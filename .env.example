# Copy this file to .env and fill in the values.
# For local Docker development the defaults below work as-is.

# Individual service grants (JSON); see docs/service-token-migration.md.
SERVICE_AUTH_TOKENS={}
# Legacy shared service bearer authentication. Read-only by default.
SERVICE_AUTH_TOKEN=
SERVICE_AUTH_SCOPES=patient/*.read
# Staging ETL example. The custom capability is accepted only by explicitly
# approved endpoints and never authorizes DELETE:
# SERVICE_AUTH_SCOPES="patient/*.read system/etl.write"

# ── Database ──────────────────────────────────────────────────────────
POSTGRES_USER=promop
POSTGRES_PASSWORD=promop
POSTGRES_DB=promop
# Port exposed on the HOST machine (the container always uses 5432 internally)
POSTGRES_PORT=5432

# ── Django ────────────────────────────────────────────────────────────
# Generate a real key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
ENVIRONMENT=local
# Explicit local HTTP conveniences; do not copy these into deployed services.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3200
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3200
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
ALLOWED_REDIRECT_URI_SCHEMES=https,http
# Optional local API password authentication (off by default):
# ENABLE_BASIC_AUTH=true
# Explicit permissive overrides, when needed (both off by default):
# ALLOWED_HOSTS=*
# CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOW_CREDENTIALS=true
# Behind a trusted non-Render proxy that strips X-Forwarded-Proto:
# TRUST_PROXY_SSL_HEADER=true
# See docs/security-settings.md for all controls and the deploy report.

# Retired SPA OAuth client IDs (#141). The built-in ctomop-smart-app is always
# blocked; add any previous custom VITE_OAUTH_CLIENT_ID here on the backend.
# OAUTH2_RETIRED_BROWSER_CLIENT_IDS=previous-custom-browser-client

# ── Admin user (created on first startup) ─────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ── URLs (leave as-is for local dev; required for production) ─────────
# The URL where your deployment is reachable (used in invitation emails).
APP_BASE_URL=http://localhost:5173

# ── Public voting on wearable mapping proposals ───────────────────────
# Optional; the defaults are shown. The voting links are built from
# APP_BASE_URL and the confirmation emails need a real mail backend
# (MAILGUN_API_KEY + MAILGUN_SENDER_DOMAIN): with the console backend no voter
# receives a link. With CELERY_BROKER_URL set the worker sends them, so it
# needs the mail variables and APP_BASE_URL too. See "Public voting on the
# wearable proposals" in docs/code-mapping-api.md.
#
# How many trusted proxies are in front of the app, for the per-client
# throttles: 0 reads the socket's peer, N the Nth entry from the right of
# X-Forwarded-For. Measure it per platform; too high is forgeable, too low
# puts every voter in one bucket.
# MAPPING_VOTE_PROXY_HOPS=0
# MAPPING_VOTE_READ_THROTTLE_RATE=60/minute
# MAPPING_VOTE_SUBMIT_THROTTLE_RATE=30/hour
# MAPPING_VOTE_CONFIRM_THROTTLE_RATE=60/hour
# MAPPING_VOTE_MAX_PENDING_PER_EMAIL=3
# MAPPING_VOTE_MAX_EMAILS_PER_DAY=5
# MAPPING_VOTE_MAX_EMAILS_PER_SHARE_PER_DAY=200
# MAPPING_VOTE_MAX_EMAILS_PER_DAY_TOTAL=500
# MAPPING_VOTE_EMAIL_TIMEOUT=10

# ── Deployment configuration (independent of DEBUG) ──
# Comma-separated list of domains your app is served from.
# Required on deployments, including staging with DEBUG=True. Example: app.example.com,www.example.com
# ALLOWED_HOSTS=app.example.com

# Comma-separated list of frontend origins allowed to make cross-origin requests.
# Required on deployments, including staging with DEBUG=True. Must include the scheme.
# Example: https://app.example.com,https://www.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com

# ── Docker: host-side knobs ───────────────────────────────────────────
# The container always listens on 8000; this is the port on the host. Handy
# when 8000 is already taken by a sibling service in a full local stack.
PROMOP_HOST_PORT=8000
# Container names, so two stacks can run side by side.
# PROMOP_DB_CONTAINER=promop_db
# PROMOP_WEB_CONTAINER=promop_web
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info

# ── Required on deployments (legacy DEBUG=False also validates) ─────────────────────────────────────
# Settings refuse to start without these, so a production-shaped container
# will not come up until they are set. Comma-separated.
# ALLOWED_HOSTS=localhost,127.0.0.1
# Origins of browsers that call this API directly. The patient app and the
# admin app are SEPARATE origins; allow-listing one but not the other fails
# that app's writes in the browser and nowhere else.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3200
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3200

# ── Firebase identity: pick ONE mode ──────────────────────────────────
# Mode A — emulator. The Admin SDK uses a null credential and accepts
# unsigned tokens. No GCP access needed; this is what the e2e suites use.
# FIREBASE_PROJECT_ID=demo-healthtree-one
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_SKIP_REVOCATION_CHECK=true
#
# Mode B — a real project (staging). Leave FIREBASE_AUTH_EMULATOR_HOST unset
# and mount Application Default Credentials. Without them the SDK initialises
# fine and the FIRST token verification raises DefaultCredentialsError, so
# every request 401s with nothing explaining why. Run once:
#   gcloud auth application-default login
# FIREBASE_PROJECT_ID=healthtree-staging-a7b7a
# GOOGLE_APPLICATION_CREDENTIALS=/adc.json
# PROMOP_ADC_SOURCE=/Users/you/.config/gcloud/application_default_credentials.json
# PROMOP_ADC_TARGET=/adc.json

# ── PHR identity service (the accounts DB for the service family) ─────
# PHR_AUDIENCE is the expected `aud` claim on incoming PHR tokens. Required
# in every environment using PHR: an unset value makes PHR JWT verification fail CLOSED
# (every PHR federation login is rejected), by design — see
# promop/settings.py for details. Set this explicitly, including for local use.
# PHR_AUDIENCE=promop-api
# PHR_ISSUER=healthkey-phr
# PHR_BASE_URL=https://phr.example.com

# ── Family auth: PROMOP as identity host (phr#43, docs/family-auth.md) ──────
# PROMOP issues the family's RS256 tokens for its own accounts, so a phr
# installation signs users in against PROMOP. Off until key + issuer are set.
#   openssl genrsa 2048 | awk 'BEGIN{ORS="\\n"}{print}'   -> one line with \n
# FAMILY_AUTH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# FAMILY_AUTH_ISSUER=https://promop.example.com
# FAMILY_AUTH_AUDIENCE=promop-api
# FAMILY_AUTH_ACCESS_SECONDS=900
# FAMILY_AUTH_REFRESH_SECONDS=604800
# Each phr installation's sign-up org (slug:Name), kept by every deploy:
# FAMILY_AUTH_SIGNUP_ORGS=phr:HealthKey PHR
# Where each installation's sign-ups verify their email (slug=origin):
# FAMILY_AUTH_APP_URLS=phr=https://phr.example.com

# ── Error monitoring (Sentry) ─────────────────────────────────────────
# Unset means the SDK never initialises, which is what local development
# and CI want. Everything else has a working default.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=<git sha>            # falls back to RENDER_GIT_COMMIT
# SENTRY_TRACES_SAMPLE_RATE=0.0       # performance tracing, off by default
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.0
# Attaches the signed-in user, cookies and auth headers to every event. This
# deployment holds patient data, so leave it off unless the Sentry project is
# covered by a DPA that allows it.
# SENTRY_SEND_DEFAULT_PII=false


# ── Garmin Connect Developer Program app (#2802) ────────────────────────────
# A patient links their Garmin account by OAuth and Garmin pushes their data.
# All four must be set before the Wearables tab offers "Garmin account".
# Register with Garmin: redirect <APP_BASE_URL>/api/v1/garmin/oauth/callback/
# and, per push type, <APP_BASE_URL>/api/v1/garmin/webhooks/<GARMIN_WEBHOOK_SECRET>/
# GARMIN_CLIENT_ID=
# GARMIN_CLIENT_SECRET=
# At least 32 random characters; the URL is the webhook's only credential:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# GARMIN_WEBHOOK_SECRET=
# The key patients' Garmin tokens are stored under (a Fernet key):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# GARMIN_TOKEN_KEY=
# GARMIN_TOKEN_KEY_FALLBACKS=         # earlier keys, comma-separated, while replacing one

# Phone sync through the Open Wearables SDK (#2810). Needs no credentials: an
# app built on the SDK is pointed at this deployment. Set to false to switch
# the routes off.
# OPEN_WEARABLES_SYNC_ENABLED=true
# GARMIN_REDIRECT_URI=                # only if the callback is not at APP_BASE_URL
