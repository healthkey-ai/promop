# Copy this file to .env and fill in the values.
# For local Docker development the defaults below work as-is.

# ── Database ──────────────────────────────────────────────────────────
POSTGRES_USER=promop
POSTGRES_PASSWORD=promop
POSTGRES_DB=promop
# Port exposed on the HOST machine (the container always uses 5432 internally)
POSTGRES_PORT=5432

# ── Django ────────────────────────────────────────────────────────────
# Generate a real key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True

# ── Admin user (created on first startup) ─────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ── URLs (leave as-is for local dev) ──────────────────────────────────
PRODUCTION_URL=http://localhost:8000
