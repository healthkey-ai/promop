# Copy this file to .env and fill in the values.
# For local Docker development the defaults below work as-is.

# ── Database ──────────────────────────────────────────────────────────
POSTGRES_USER=promop
POSTGRES_PASSWORD=promop
POSTGRES_DB=promop
# Port exposed on the HOST machine (the container always uses 5432 internally)
POSTGRES_PORT=5432

# ── Django ────────────────────────────────────────────────────────────
# Generate a real key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True

# ── Admin user (created on first startup) ─────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ── URLs (leave as-is for local dev; required for production) ─────────
# The URL where your deployment is reachable (used in invitation emails).
APP_BASE_URL=http://localhost:5173

# ── Production-only (not needed for local Docker dev with DEBUG=True) ──
# Comma-separated list of domains your app is served from.
# Required in production (DEBUG=False). Example: app.example.com,www.example.com
# ALLOWED_HOSTS=app.example.com

# Comma-separated list of frontend origins allowed to make cross-origin requests.
# Required in production (DEBUG=False). Must include the scheme.
# Example: https://app.example.com,https://www.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
