# Copy this file to .env and fill in the values.
# For local Docker development the defaults below work as-is.

# Individual service grants (JSON); see docs/service-token-migration.md.
SERVICE_AUTH_TOKENS={}
# Legacy shared service bearer authentication. Read-only by default.
SERVICE_AUTH_TOKEN=
SERVICE_AUTH_SCOPES=patient/*.read
# Staging ETL example. The custom capability is accepted only by explicitly
# approved endpoints and never authorizes DELETE:
# SERVICE_AUTH_SCOPES="patient/*.read system/etl.write"

# ── Database ──────────────────────────────────────────────────────────
POSTGRES_USER=promop
POSTGRES_PASSWORD=promop
POSTGRES_DB=promop
# Port exposed on the HOST machine (the container always uses 5432 internally)
POSTGRES_PORT=5432

# ── Django ────────────────────────────────────────────────────────────
# Generate a real key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
ENVIRONMENT=local
# Explicit local HTTP conveniences; do not copy these into deployed services.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3200
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3200
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
ALLOWED_REDIRECT_URI_SCHEMES=https,http
# Optional local API password authentication (off by default):
# ENABLE_BASIC_AUTH=true
# Explicit permissive overrides, when needed (both off by default):
# ALLOWED_HOSTS=*
# CORS_ALLOW_ALL_ORIGINS=true
# CORS_ALLOW_CREDENTIALS=true
# Behind a trusted non-Render proxy that strips X-Forwarded-Proto:
# TRUST_PROXY_SSL_HEADER=true
# See docs/security-settings.md for all controls and the deploy report.

# ── Admin user (created on first startup) ─────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# ── URLs (leave as-is for local dev; required for production) ─────────
# The URL where your deployment is reachable (used in invitation emails).
APP_BASE_URL=http://localhost:5173

# ── Deployment configuration (independent of DEBUG) ──
# Comma-separated list of domains your app is served from.
# Required on deployments, including staging with DEBUG=True. Example: app.example.com,www.example.com
# ALLOWED_HOSTS=app.example.com

# Comma-separated list of frontend origins allowed to make cross-origin requests.
# Required on deployments, including staging with DEBUG=True. Must include the scheme.
# Example: https://app.example.com,https://www.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com

# ── Docker: host-side knobs ───────────────────────────────────────────
# The container always listens on 8000; this is the port on the host. Handy
# when 8000 is already taken by a sibling service in a full local stack.
PROMOP_HOST_PORT=8000
# Container names, so two stacks can run side by side.
# PROMOP_DB_CONTAINER=promop_db
# PROMOP_WEB_CONTAINER=promop_web
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info

# ── Required on deployments (legacy DEBUG=False also validates) ─────────────────────────────────────
# Settings refuse to start without these, so a production-shaped container
# will not come up until they are set. Comma-separated.
# ALLOWED_HOSTS=localhost,127.0.0.1
# Origins of browsers that call this API directly. The patient app and the
# admin app are SEPARATE origins; allow-listing one but not the other fails
# that app's writes in the browser and nowhere else.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3200
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3200

# ── Firebase identity: pick ONE mode ──────────────────────────────────
# Mode A — emulator. The Admin SDK uses a null credential and accepts
# unsigned tokens. No GCP access needed; this is what the e2e suites use.
# FIREBASE_PROJECT_ID=demo-healthtree-one
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_SKIP_REVOCATION_CHECK=true
#
# Mode B — a real project (staging). Leave FIREBASE_AUTH_EMULATOR_HOST unset
# and mount Application Default Credentials. Without them the SDK initialises
# fine and the FIRST token verification raises DefaultCredentialsError, so
# every request 401s with nothing explaining why. Run once:
#   gcloud auth application-default login
# FIREBASE_PROJECT_ID=healthtree-staging-a7b7a
# GOOGLE_APPLICATION_CREDENTIALS=/adc.json
# PROMOP_ADC_SOURCE=/Users/you/.config/gcloud/application_default_credentials.json
# PROMOP_ADC_TARGET=/adc.json

# ── PHR identity service (the accounts DB for the service family) ─────
# PHR_AUDIENCE is the expected `aud` claim on incoming PHR tokens. Required
# in every environment using PHR: an unset value makes PHR JWT verification fail CLOSED
# (every PHR federation login is rejected), by design — see
# ctomop/settings.py for details. Set this explicitly, including for local use.
# PHR_AUDIENCE=promop-api
# PHR_ISSUER=healthkey-phr
# PHR_BASE_URL=https://phr.example.com

# ── Error monitoring (Sentry) ─────────────────────────────────────────
# Unset means the SDK never initialises, which is what local development
# and CI want. Everything else has a working default.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=<git sha>            # falls back to RENDER_GIT_COMMIT
# SENTRY_TRACES_SAMPLE_RATE=0.0       # performance tracing, off by default
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.0
# Attaches the signed-in user, cookies and auth headers to every event. This
# deployment holds patient data, so leave it off unless the Sentry project is
# covered by a DPA that allows it.
# SENTRY_SEND_DEFAULT_PII=false
