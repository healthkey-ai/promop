# Code owners for healthkey-ai/promop.
#
# Purpose is SOC2 CC8.1 change management: declare who should review changes to
# security-relevant code. The Security review status requires approval from
# @larsburgess for security-related changes once rollout is complete. Paths below are ordered least- to
# most-specific; the LAST matching pattern wins, so the security paths at the
# bottom override the catch-all at the top.
#
# This file routes review; it does not itself enforce approval. The target
# branch's copy is authoritative, and authors cannot approve their own PRs.
# Security review scope and evidence: docs/soc2/change-management.md.

# Default owner for everything not matched below.
*                                   @adamblum

# ── Authorization and identity ────────────────────────────────────────────────
# Every P0 finding in the security audit lived in one of these paths.
/omop_core/authorization.py         @larsburgess
/patient_portal/api/permissions.py  @larsburgess
/patient_portal/api/authentication.py  @larsburgess
/patient_portal/api/providers/      @larsburgess
/patient_portal/services.py         @larsburgess
/patient_portal/api/break_glass.py  @larsburgess

# ── Configuration and security checks ───────────────────────────────────────
# Settings modules control auth backends, secret keys, and CORS policy. The
# OAuth validator decides which clients may still authenticate; the Sentry
# module decides what leaves the process.
#
# Patterns, not exact filenames, and deliberately the same shape the gate in
# .github/scripts/security-review.cjs uses: an entry that covers less than the
# gate does asks for no reviewer on a change the gate will still hold, which
# reads as the gate being broken rather than as the owner list being stale.
/promop/*settings*                  @larsburgess
/promop/settings/                   @larsburgess
/ctomop/*settings*                  @larsburgess
/ctomop/settings/                   @larsburgess
/promop/oauth.py                    @larsburgess
/promop/oauth/                      @larsburgess
/ctomop/oauth.py                    @larsburgess
/ctomop/oauth/                      @larsburgess
/promop/sentry.py                   @larsburgess
/promop/sentry/                     @larsburgess
/ctomop/sentry.py                   @larsburgess
/ctomop/sentry/                     @larsburgess
/patient_portal/checks.py           @larsburgess
/frontend/package*.json             @larsburgess

# ── CI and the security gates themselves ──────────────────────────────────────
# A change that weakens a gate should be as visible as a change that trips it.
/.github/                           @larsburgess
/.gitleaks.toml                     @larsburgess
/.bandit-baseline.json              @larsburgess

# ── Ownership and change-management evidence ────────────────────────────────
/CODEOWNERS                         @larsburgess
/docs/soc2/                         @larsburgess
/scripts/capture_change_management_evidence.py  @larsburgess
