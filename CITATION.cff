# not need editing on every release. The version-specific DOIs are
# 10.5281/zenodo.22030233 (1.1.0) and 10.5281/zenodo.21194710 (1.0.0).
doi: "10.5281/zenodo.21194709"
keywords:
  - OMOP CDM
